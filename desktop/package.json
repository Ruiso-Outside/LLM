{
  "name": "llm-local",
  "productName": "LLM Local",
  "version": "1.3.0",
  "description": "IA local no seu PC, sem conta e sem restrições",
  "main": "main.js",
  "author": "Piphin Studio",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node gen-icon.js",
    "dist": "node gen-icon.js && electron-builder --win nsis --publish never",
    "release": "node gen-icon.js && node scripts/release-check.js && electron-builder --win nsis --publish always && node scripts/release-check.js --verify"
  },
  "build": {
    "appId": "studio.piphin.llmlocal",
    "productName": "LLM Local",
    "copyright": "Piphin Studio",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon-tray.png",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "server",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LLM Local",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ruiso-Outside",
        "repo": "LLM",
        "releaseType": "release"
      }
    ],
    "asar": false
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
