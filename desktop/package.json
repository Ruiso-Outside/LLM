{
  "name": "llm-local",
  "productName": "LLM Local",
  "version": "1.27.0",
  "description": "Piphin LLM: IA local no seu PC, sem conta e sem restrições (Piphin Studio)",
  "main": "main.js",
  "author": "Piphin Studio",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icons.js icon-source.webp",
    "dist": "electron-builder --win --publish never && node scripts/make-patch.js && node scripts/make-module.js",
    "module": "node scripts/make-module.js",
    "release": "node scripts/release-check.js && electron-builder --win --publish always && node scripts/make-module.js && node scripts/make-patch.js --upload && node scripts/release-check.js --verify --wait-installer",
    "verify-release": "node scripts/release-check.js --verify --wait-installer",
    "module-icon": "electron scripts/make-module-icon.js"
  },
  "build": {
    "appId": "studio.piphin.llmlocal",
    "productName": "LLM Local",
    "copyright": "Piphin Studio",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon-tray.png",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "server",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "LLM-Local-${version}-win-x64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ruiso-Outside",
        "repo": "LLM",
        "releaseType": "release"
      }
    ],
    "asar": false
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  }
}
